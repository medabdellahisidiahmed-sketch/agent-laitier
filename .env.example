# Modèle des variables à saisir dans Render > Environment.
# Ne mettez JAMAIS de vraies clés ici (dépôt public).

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NOM_SOCIETE=Laiterie Example
ADMIN_TOKEN=choisissez-un-mot-de-passe-long
STOCK_SHEET_URL=
COMMANDES_WEBHOOK_URL=
ALERTES_WEBHOOK_URL=
STOCK_WEBHOOK_URL=
SHEETS_CLE=choisissez-une-cle-longue-identique-a-celle-des-scripts

# Plus tard, seulement si vous connectez WhatsApp :
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=laitier2026
# NUMERO_RESPONSABLE=


# Alerte e-mail par Google (gratuit) : 1 pour activer, voir GUIDE_DEPLOIEMENT.md
ALERTE_EMAIL=

# Notifications téléphone (clés VAPID, voir GUIDE_DEPLOIEMENT.md)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Livraison à une date choisie par le client
# LIV_JOURS_MAX=14                    # jusqu'à combien de jours à l'avance
# LIV_JOURS_SANS=vendredi,dimanche    # jours sans livraison (facultatif)
